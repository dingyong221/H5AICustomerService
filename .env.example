# Public browser variables. Every NEXT_PUBLIC_* value is shipped to the browser.
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_MERCHANT_API_BASE_URL=http://127.0.0.1:4000/api/v1
NEXT_PUBLIC_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/api/v1/public
NEXT_PUBLIC_CONSUMER_H5_ORIGIN=http://127.0.0.1:3001
CONSUMER_H5_ORIGIN=http://127.0.0.1:3001

# Server-only runtime settings. Never rename these with a NEXT_PUBLIC_ prefix.
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
HOST=127.0.0.1
PORT=4000
WORKER_CONCURRENCY=2
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3011
WORKER_POLL_INTERVAL_MS=5000

# Local Docker Compose infrastructure. These are disposable development-only values.
H5CS_MYSQL_DATABASE=h5_ai_customer_service_dev
H5CS_MYSQL_USER=h5cs_dev
H5CS_MYSQL_PASSWORD=local-dev-app-only
H5CS_MYSQL_ROOT_PASSWORD=local-dev-root-only
H5CS_MYSQL_PORT=3306
H5CS_REDIS_PASSWORD=local-dev-redis-only
H5CS_REDIS_PORT=6379

# Server-only service connection strings. Replace every credential outside local development.
MYSQL_DATABASE_URL=mysql://h5cs_dev:local-dev-app-only@127.0.0.1:3306/h5_ai_customer_service_dev
REDIS_URL=redis://:local-dev-redis-only@127.0.0.1:6379/0

# Server-only cryptographic placeholders. Generate independent random values per environment.
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-bytes
VISITOR_CREDENTIAL_HMAC_KEY=replace-with-an-independent-32-byte-key
FIELD_ENCRYPTION_KEY=replace-with-the-required-kms-or-key-reference

# Local platform-session adapter. Production must use an approved __Host- session cookie name and
# the exact canonical HTTPS Merchant Web origin; comma-separated origins are all matched exactly.
PLATFORM_LOGIN_SESSION_COOKIE_NAME=h5cs_session
PLATFORM_LOGIN_ALLOWED_ORIGINS=http://127.0.0.1:3000

# Connector OAuth and management links. Production issuer/resource must use the canonical HTTPS
# origin. Access-token signing remains fail closed until an approved key adapter is configured.
OAUTH_ISSUER=http://127.0.0.1:4000
OAUTH_MCP_RESOURCE=http://127.0.0.1:4000/mcp
WORKBUDDY_CONNECTOR_SOURCE=h5-ai-customer-service
MANAGEMENT_CONSOLE_URL=http://127.0.0.1:3000

# WorkBuddy Open API credentials are a complete server-only set. Leave all four unset outside an
# approved integration environment; never expose them through NEXT_PUBLIC_* variables.
WORKBUDDY_OPEN_API_CLIENT_ID=replace-with-approved-client-id
WORKBUDDY_OPEN_API_CLIENT_SECRET=replace-with-approved-client-secret
WORKBUDDY_OPEN_API_REDIRECT_URI=http://127.0.0.1:4000/api/v1/auth/workbuddy/callback
WORKBUDDY_OPEN_API_SCOPES=replace-with-approved-space-delimited-scopes

# Server-only provider configuration. Local development defaults to a non-network mock.
MODEL_PROVIDER=mock
MODEL_API_KEY=replace-with-provider-secret-when-not-using-mock
MODEL_NAME=replace-with-approved-model-name
