{
  "name": "h5-ai-customer-service",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "release:check": "node scripts/quality/release-gate.mjs repository --version 0.1.0",
    "release:static": "node scripts/quality/release-gate.mjs static --version 0.1.0",
    "test": "turbo run test && pnpm test:quality-tools",
    "test:e2e": "playwright test",
    "test:quality-tools": "pnpm exec turbo run build --filter=@h5cs/worker --concurrency=1 && node --test scripts/quality/consumer-scenario-probe.test.mjs scripts/quality/improvement-model-scenarios.test.mjs scripts/quality/staging-improvement-smoke.test.mjs scripts/quality/verify-ci-mysql-restore.test.mjs",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "catalog:",
    "prettier": "3.9.8",
    "turbo": "2.11.2",
    "typescript": "6.0.3"
  }
}
