# Contract only. Do not mount this file in production or commit populated values.
# Use a dedicated, root-owned /etc/h5-ai-customer-service/worker.env with mode 0600.
MYSQL_DATABASE_URL=
CONVERSATION_WORKER_ENABLED=false
MODEL_PROVIDER=disabled
MODEL_CHAT_COMPLETIONS_URL=
MODEL_NAME=
# Set exactly one of MODEL_API_KEY and MODEL_API_KEY_FILE. A production secret file
# must be mounted read-only into the worker and readable by its uid 1000 process.
MODEL_API_KEY=
MODEL_API_KEY_FILE=
WORKER_POLL_INTERVAL_MS=5000
