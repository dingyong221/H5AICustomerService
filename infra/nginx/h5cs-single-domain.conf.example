# Candidate only: do not install until the single-domain route, formal certificate,
# exact image digests, backup/restore and release change have been approved.
# The fixed loopback ports are the initial Compose slot; blue/green switching must
# replace them with the reviewed slot ports and pass nginx -t before reload.

server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name h5cs.1rying.com;
    server_tokens off;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /gateway-health {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    location / {
        return 308 https://h5cs.1rying.com$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name h5cs.1rying.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/h5cs.1rying.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/h5cs.1rying.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    if ($host != h5cs.1rying.com) {
        return 444;
    }

    client_max_body_size 20m;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    # Increase only after TLS and subdomain policy have been verified in staging.
    add_header Strict-Transport-Security "max-age=300" always;

    access_log /var/log/nginx/h5-ai-customer-service.access.log;
    error_log /var/log/nginx/h5-ai-customer-service.error.log warn;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location = /gateway-health {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"status":"ok","service":"gateway"}';
    }

    location = /ops {
        return 308 /ops/;
    }
    location ^~ /ops/ {
        proxy_pass http://127.0.0.1:13002;
    }

    location = /console {
        return 308 /console/;
    }
    location ^~ /console/ {
        proxy_pass http://127.0.0.1:13000;
    }

    # WorkBuddy integration is deferred for the Web-only release.
    location ^~ /api/v1/skill {
        return 404;
    }
    location ^~ /mcp {
        return 404;
    }
    location ^~ /oauth/ {
        return 404;
    }
    location ^~ /.well-known/oauth- {
        return 404;
    }
    location ^~ /api/ {
        proxy_buffering off;
        proxy_cache off;
        proxy_pass http://127.0.0.1:14000;
    }

    # Consumer H5 owns /a/*, /_next/* and the remaining public site shell.
    location / {
        proxy_pass http://127.0.0.1:13001;
    }
}
